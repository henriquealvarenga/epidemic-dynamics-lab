# macOS
.DS_Store
._*

# Editors
.vscode/
.idea/
*.swp
*.swo

# R
.Rhistory
.Rproj.user/

# Python (for scripts/bib2json.py)
__pycache__/
*.pyc
.venv/
venv/

# Node (if anyone ever adds tooling later)
node_modules/
npm-debug.log

# OS junk
Thumbs.db
Desktop.ini

# Local-only working files (images under consideration, not yet licensed)
_scratch/
_sources/
*.tmp

# Binários não versionáveis
*.pdf

# Claude Code — permissões locais são pessoais; launch.json é config de dev
# compartilhada (aponta para scripts/devserver.py) e fica versionado.
.claude/settings.local.json

# Staging da publicação, montado pelo CI
_site/

# Supabase CLI — estado local do vínculo com o projeto
supabase/.temp/

# Quarto — cache de render da página Leituras
.quarto/
**/*.quarto_ipynb

# Subprodutos de `quarto render` sem argumento: o Quarto varre o diretório e
# renderiza também _leituras-refs.md, que é fragmento de include e não página.
# O resultado é uma cópia órfã e sem estilo da lista inteira, mais ~900 KB de
# Bootstrap que leituras.html (minimal: true) não usa. Renderize sempre com o
# alvo explícito: `quarto render leituras.qmd`.
_leituras-refs.html
_leituras-refs_files/
